<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Gera packages/dfe_nfe/lib/src/enderecos_tabela.g.dart a partir das tabelas
    de URLs do ZeusFiscal (Enderecador e ExtinfNFeSupl).

    Uso: dotnet run -c Release -p:ZeusDir=(pasta do zeus_fiscal) (traço-traço) (arquivo .dart de saída)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ZeusDir Condition="'$(ZeusDir)' == ''">D:\Pessoas\Outros\Projetos\zeus_fiscal</ZeusDir>
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(ZeusDir)\NFe.Utils\NFe.Utils.csproj" />
  </ItemGroup>
</Project>
